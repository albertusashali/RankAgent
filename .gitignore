# =========================================================================
# RankAgent Git Ignore Rules
# =========================================================================

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets (NEVER COMMIT API KEYS)
.env
.env.local
.env.*.local
*.env
!.env.example

# Datasets & Large CSV Logs (Do not push gigabyte data files to GitHub)
data/
*.csv
*.tsv
*.zip
*.tar.gz
*.parquet
KuaiRand*/

# Model Weights, Embeddings & Checkpoints
*.pt
*.pth
*.bin
*.onnx
*.pkl
*.joblib
checkpoints/
models_saved/

# Temporary Workspace & Active Sandbox Runs
workspace/
temp/
tmp/
*.log

# IDEs & System Files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Submissions (Keep submission directory structure but ignore large outputs if needed)
submissions/*.csv
!submissions/sample_submission.csv

